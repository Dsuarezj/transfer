{
  "id": "default",
  "name": "Generic Receipt",
  "keywords": [],
  "patterns": [
    {
      "id": "generic-number",
      "priority": 1,
      "contextKeywords": ["numero", "no", "ref", "referencia", "codigo", "comprobante", "transaccion"],
      "numberPattern": "\\d{4,}",
      "proximity": 250,
      "position": "any",
      "separators": [":", "-", ".", "#"],
      "examples": ["123456", "12345678"]
    }
  ],
  "preprocessing": {
    "contrast": 1.3,
    "brightness": 1.1,
    "sharpen": true,
    "threshold": false
  }
}
